{%- comment -%}
  Cart drawer, opened by the header link and closed by the backdrop or the
  close button. Built on :target so it works with CSS alone — no script, and it
  survives a page that has not finished loading its JavaScript.

  Known limitation, stated rather than hidden: :target moves the browser's
  scroll position but does not move focus into the panel, so a screen-reader
  user lands on the drawer by tabbing rather than being placed there. A real
  build would add a few lines of JS for focus management.
{%- endcomment -%}

{%- liquid
  assign current = shop.metafields.lammas.current_week.value
  assign methods = shop.metaobjects.delivery_method.values | sort: 'position'
  assign date = cart.attributes['Delivery date']
  assign method = cart.attributes['Method']
  if date == blank
    for item in cart.items
      if item.properties['Delivery date'] != blank and date == blank
        assign date = item.properties['Delivery date']
      endif
    endfor
  endif
  if method == blank
    assign method = 'van'
  endif
  assign method_label = ''
  assign method_price = 0
  for m in methods
    if m.value.value == method
      assign method_label = m.label.value
      assign method_price = m.price.value
    endif
  endfor
-%}
{%- capture problems -%}{% render 'cart-problems', date: date, method: method %}{%- endcapture -%}
{%- assign blocked = false -%}
{%- if problems contains '<li>' -%}{%- assign blocked = true -%}{%- endif -%}

<aside class="drawer" id="cart-drawer" aria-label="Cart">
  <a class="drawer__backdrop" href="#" aria-label="Close cart" tabindex="-1"></a>

  <div class="drawer__panel" role="dialog" aria-modal="false" aria-labelledby="drawer-title">
    <div class="drawer__head">
      <h2 class="display" id="drawer-title">Your cart ({{ cart.item_count }})</h2>
      <a class="drawer__close" href="#" aria-label="Close cart">&times;</a>
    </div>

    {%- if cart.items.size > 0 -%}
      {%- if blocked -%}
        <div class="problems" role="alert">
          <p class="problems__head">This order cannot be placed yet</p>
          <ul>{{ problems }}</ul>
        </div>
      {%- endif -%}

      <div class="drawer__lines">
        {%- for item in cart.items -%}
          {% render 'cart-line', item: item, method: method, compact: true %}
        {%- endfor -%}
      </div>

      <div class="drawer__foot">
        <div class="summary__row"><span>Subtotal</span><span class="num">{{ cart.items_subtotal_price | money }}</span></div>
        <div class="summary__row">
          <span>Delivery <span class="muted">· {{ method_label }}</span></span>
          <span class="num">{% if method_price > 0 %}{{ method_price | money }}{% else %}Free{% endif %}</span>
        </div>
        <div class="summary__row summary__row--total"><span>Total</span><span class="num">{{ cart.total_price | money }}</span></div>

        <a class="btn btn--wide" href="{{ routes.cart_url }}">View cart</a>
        {%- if blocked -%}
          <button class="btn btn--ghost btn--wide" type="button" disabled>Checkout</button>
        {%- else -%}
          <form action="{{ routes.cart_url }}" method="post">
            <button class="btn btn--ghost btn--wide" type="submit" name="checkout">Checkout</button>
          </form>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="drawer__empty muted">Nothing in the cart yet. Week {{ current.number }} is on the bench.</p>
      <a class="btn btn--wide" href="/collections/week-{{ current.number }}">See this week</a>
    {%- endif -%}
  </div>
</aside>
